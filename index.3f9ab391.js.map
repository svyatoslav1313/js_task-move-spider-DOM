    var newTop = clickY - wallRect.top - wallBorder - spiderHeight / 2;
    if (left < spiderWidth) left = 0;
    if (newTop < spiderHeight) newTop = 0;
    if (wallRect.height - wallBorder - newTop < spiderHeight) newTop = wallRect.height - spiderHeight - wallBorder * 2;
    if (wallRect.width - wallBorder - left < spiderWidth) left = wallRect.width - spiderWidth - wallBorder * 2;
    spider.style.left = "".concat(left, "px");
    spider.style.top = "".concat(newTop, "px");
});

